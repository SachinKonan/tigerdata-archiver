# Copy to .env and fill in. Never commit .env.

# UUID of your TigerData Globus collection (e.g. "Princeton TigerData - <pi>/<project>").
# Find it with:  uv run globus endpoint search "TigerData"
GLOBUS_COLLECTION_ID=

# HTTPS server of that collection, e.g. https://m-xxxxxx.xxxxxx.xxxx.data.globus.org
# Leave blank to look it up from the collection automatically.
GLOBUS_HTTPS_SERVER=

# Where parts are staged before upload (needs ~3-5 GB per running task).
# Default: /scratch/$USER if it exists, else $TMPDIR.
TDA_STAGING_DIR=

# Where run state, plans, indexes and logs are kept.
# Default: ~/.local/state/tigerdata-archiver
TDA_STATE_DIR=

# Optional Slurm settings for submitted jobs.
SLURM_PARTITION=
SLURM_ACCOUNT=
